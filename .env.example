# =============================================================================
# Giga Assistant Backend - environment configuration
# Copy to ".env" and fill in real values. Never commit ".env".
# =============================================================================

APP_NAME=Giga
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Database (SQLite for development; use PostgreSQL in production)
# PostgreSQL example: postgresql+asyncpg://user:password@localhost:5432/giga
DATABASE_URL=sqlite+aiosqlite:///./giga.db

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# Default provider name. One of: freellmapi, openrouter, openai, openai_compat
DEFAULT_LLM_PROVIDER=freellmapi
# Default model used when a request does not select one.
LLM_MODEL=
# Comma-separated provider names tried in order when the primary provider
# fails with a retryable error (outage / rate limit). Example: openrouter,openai
PROVIDER_FALLBACKS=
LLM_TIMEOUT_SECONDS=60

# FreeLLMAPI (OpenAI-compatible). Set the base URL from your FreeLLMAPI
# dashboard/instance, e.g. https://api.freellmapi.com/v1
FREELLMAPI_BASE_URL=
FREELLMAPI_API_KEY=

# OpenRouter (https://openrouter.ai) - base URL is fixed by the provider.
OPENROUTER_API_KEY=

# Generic OpenAI-compatible provider ("openai" or "openai_compat").
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=

# Generation defaults
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1024
# Maximum LLM <-> tool round-trips per user message.
MAX_TOOL_ITERATIONS=5
# Maximum messages from history sent to the LLM per request.
CONTEXT_MESSAGE_LIMIT=100

# -----------------------------------------------------------------------------
# Speech-to-text (Deepgram realtime WebSocket API)
# -----------------------------------------------------------------------------
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-2
STT_LANGUAGE=en
STT_SAMPLE_RATE=16000
STT_CHANNELS=1

# -----------------------------------------------------------------------------
# Text-to-speech
# Providers: openai (OpenAI-compatible /audio/speech), deepgram (Aura streaming)
# -----------------------------------------------------------------------------
TTS_PROVIDER=openai
TTS_API_KEY=
# Only needed for openai-compatible TTS endpoints other than api.openai.com
TTS_BASE_URL=
TTS_MODEL=tts-1
TTS_VOICE=alloy

# -----------------------------------------------------------------------------
# MCP runtime security
# -----------------------------------------------------------------------------
# Comma-separated list of executables allowed for stdio MCP servers,
# e.g. npx,uvx,python,docker. Empty list = no stdio server may be started.
MCP_STDLIB_ALLOWLIST=
# Comma-separated host patterns allowed for HTTP/SSE MCP servers
# (supports * wildcards, e.g. *.example.com). Empty = any public HTTPS host,
# plus loopback for local development. Private/link-local IPs are always blocked
# unless explicitly listed.
MCP_HTTP_HOST_ALLOWLIST=
MCP_TOOL_TIMEOUT_SECONDS=30
MCP_MAX_CONCURRENT_TOOLS=4
# Comma-separated regex patterns; matching tools require explicit approval
# per request before execution.
MCP_APPROVAL_REQUIRED_PATTERNS=send_message,send_email,delete_,purchase,payment,transfer

# -----------------------------------------------------------------------------
# Authentication & security
# -----------------------------------------------------------------------------
# Use a long random value in production (e.g. `openssl rand -hex 32`).
AUTH_SECRET=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Comma-separated allowed CORS origins, e.g. http://localhost:3000,https://giga.example.com
ALLOWED_ORIGINS=
# Maximum accepted request body size in bytes.
MAX_BODY_BYTES=2097152
# Sliding-window rate limits.
LOGIN_RATE_LIMIT_PER_MINUTE=10
CHAT_RATE_LIMIT_PER_MINUTE=60
